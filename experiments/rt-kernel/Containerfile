FROM docker.io/library/ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    gcc libc6-dev g++-aarch64-linux-gnu gcc-aarch64-linux-gnu autoconf automake libtool binutils-aarch64-linux-gnu cmake ninja-build make \
    bc bison flex libssl-dev libelf-dev kmod cpio python3 git ca-certificates xz-utils rsync file \
    && rm -rf /var/lib/apt/lists/*

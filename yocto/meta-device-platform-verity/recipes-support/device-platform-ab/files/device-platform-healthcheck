#!/bin/sh
# Decide whether the slot that just booted is healthy, and tell RAUC.
# `rauc status mark-good` makes the backend commit a slot that was booted
# through tryboot; a slot that never gets here is never committed, and the
# next reboot returns to the old one (docs/security/update-and-provisioning.md §3).
set -u
if [ -e /run/device-platform-data.degraded ]; then
	echo "healthcheck: /data is degraded (tmpfs) - not marking this slot good"
	exit 1
fi
for i in $(seq 1 60); do
	if systemctl is-active --quiet device-service &&
	   [ "$(cat /sys/bus/spi/devices/spi0.0/device_id 2>/dev/null)" = 0xac00acc0 ]; then
		echo "healthcheck: device-service active, MCU answering - marking slot good"
		exec rauc status mark-good
	fi
	sleep 5
done
echo "healthcheck: not healthy after 5 minutes - leaving the slot uncommitted"
exit 1
